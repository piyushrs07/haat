# Local development only. Copy to .env and export, or just run with defaults
# (DEBUG is on and SQLite is used automatically when nothing is set).
DEBUG=True
# DATABASE_URL=mysql://root:root@localhost:3306/local_vendor_app   # needs `pip install mysqlclient` locally
# BREVO_API_KEY=            # leave empty locally: the OTP is printed in the terminal when DEBUG=True
